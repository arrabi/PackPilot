# Public project URL and publishable (or legacy anon) key, never a secret key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Exact publicly deployed MCP endpoint; also used for OAuth resource discovery.
MCP_RESOURCE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/scouts-mcp
# Origin hosting the consent page (used for browser-origin validation).
AUTH_UI_ORIGIN=http://localhost:5173
