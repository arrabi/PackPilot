name: Production readiness audit
on:
  workflow_dispatch:
    inputs:
      commit:
        description: Exact owner-approved staging commit (full SHA)
        required: true
        type: string
      staging_run:
        description: Successful unchanged main Staging integration run ID
        required: true
        type: string
permissions:
  contents: read
  actions: read
concurrency:
  group: pack99-production-operations
  cancel-in-progress: false
jobs:
  audit:
    if: github.actor == 'YOUR_GITHUB_OWNER' && github.ref == 'refs/heads/main'
    environment: production
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v5
        with:
          path: controller
      - uses: actions/checkout@v5
        with:
          ref: ${{ inputs.commit }}
          path: candidate
          fetch-depth: 0
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - run: pip install -r controller/scripts/release/requirements.txt
      - name: Install provider CA for verified database TLS
        run: |
          ca_file="$RUNNER_TEMP/pack99-supabase-ca-2021.crt"
          curl --fail --silent --show-error --proto '=https' --tlsv1.2 'https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt' --output "$ca_file"
          openssl x509 -in "$ca_file" -noout -checkend 86400
          openssl x509 -in "$ca_file" -noout -ext basicConstraints | grep -q 'CA:TRUE'
          echo "PGSSLROOTCERT=$ca_file" >> "$GITHUB_ENV"
      - name: Read production bindings and adoption gates
        env:
          APPROVED_SHA: ${{ inputs.commit }}
          STAGING_RUN: ${{ inputs.staging_run }}
          GH_TOKEN: ${{ github.token }}
          SUPABASE_ACCESS_KEY: ${{ secrets.SUPABASE_ACCESS_KEY }}
          PRODUCTION_DATABASE_URL: ${{ secrets.PRODUCTION_DATABASE_URL }}
          PRODUCTION_SUPABASE_SERVICE_KEY: ${{ secrets.PRODUCTION_SUPABASE_SERVICE_KEY }}
          CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          R2_ENDPOINT: ${{ secrets.R2_ENDPOINT }}
          R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
          R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
        run: python controller/scripts/release/production_preflight.py --candidate-root candidate --commit "$APPROVED_SHA" --staging-run "$STAGING_RUN"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: production-preflight-${{ github.run_id }}
          path: production-preflight.json
          if-no-files-found: warn
          retention-days: 7
