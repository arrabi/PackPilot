name: Production backups
on:
  schedule:
    - cron: '15 10 * * *'
  workflow_dispatch:
    inputs:
      setup_check:
        description: Capture/read back one backup and check freshness without enabling schedules or deleting recovery points
        type: boolean
        default: false
permissions:
  contents: read
concurrency:
  group: pack99-production-operations
  cancel-in-progress: false
jobs:
  backup:
    if: >-
      github.ref == 'refs/heads/main' &&
      (vars.PACK99_BACKUPS_ENABLED == 'true' ||
       (github.event_name == 'workflow_dispatch' && inputs.setup_check))
    runs-on: ubuntu-latest
    timeout-minutes: 45
    environment: production-backups
    steps:
      - uses: actions/checkout@v5
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - name: Install PostgreSQL 17 client
        run: |
          sudo install -d /usr/share/postgresql-common/pgdg
          curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | sudo tee /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc >/dev/null
          . /etc/os-release
          echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $VERSION_CODENAME-pgdg main" | sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
          sudo apt-get update -qq
          sudo apt-get install -y postgresql-client-17
          echo /usr/lib/postgresql/17/bin >> "$GITHUB_PATH"
      - run: pip install -r scripts/release/requirements.txt
      - name: Install Supabase database CA for verified TLS
        run: |
          ca_file="$RUNNER_TEMP/pack99-supabase-ca-2021.crt"
          curl --fail --silent --show-error --proto '=https' --tlsv1.2 'https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt' --output "$ca_file"
          openssl x509 -in "$ca_file" -noout -checkend 86400
          openssl x509 -in "$ca_file" -noout -ext basicConstraints | grep -q 'CA:TRUE'
          echo "PGSSLROOTCERT=$ca_file" >> "$GITHUB_ENV"
      - name: Capture, verify and retain recovery points
        env:
          PRODUCTION_DATABASE_URL: ${{ secrets.PRODUCTION_DATABASE_URL }}
          PRODUCTION_SUPABASE_URL: https://aaaaaaaaaaaaaaaaaaaa.supabase.co
          PRODUCTION_SUPABASE_SERVICE_KEY: ${{ secrets.PRODUCTION_SUPABASE_SERVICE_KEY }}
          CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
          R2_ENDPOINT: ${{ secrets.R2_ENDPOINT }}
          R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
          R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
          BREVO_API_KEY: ${{ secrets.BREVO_API_KEY }}
          PACK99_FROM_EMAIL: admin@example.test
          SCHEDULED: ${{ github.event_name == 'schedule' }}
          SETUP_CHECK: ${{ inputs.setup_check }}
        run: |
          args=()
          if [ "$SCHEDULED" = 'true' ]; then args+=(--scheduled); fi
          if [ "$SETUP_CHECK" = 'true' ]; then
            python scripts/release/backup.py backup
            python scripts/release/backup.py freshness
            python - <<'PY'
          import os
          import urllib.request
          key = os.environ['PRODUCTION_SUPABASE_SERVICE_KEY']
          request = urllib.request.Request('https://aaaaaaaaaaaaaaaaaaaa.supabase.co/rest/v1/',
              headers={'apikey': key, 'Authorization': 'Bearer ' + key})
          with urllib.request.urlopen(request, timeout=30) as response:
              response.read()
          if not os.environ.get('BREVO_API_KEY'):
              raise SystemExit('Missing operational alert credential')
          print('Backup/freshness and production API binding verified; alert binding present, delivery not tested')
          PY
          else
            python scripts/release/backup.py backup --alert-on-failure "${args[@]}"
            python scripts/release/backup.py cleanup --alert-on-failure
            python scripts/release/expire-records.py
          fi
